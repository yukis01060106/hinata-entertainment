# HINATA Entertainment（Xserver 用）。scripts/deploy-xserver.sh が public_html に置く。

DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# http でアクセスされたら https に転送する
RewriteCond %{HTTPS} !on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www 付きでアクセスされたら、www なしに統一する（検索エンジンの評価を1つにまとめる）
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# フォームの設定ファイルは、外から見せない
<Files "contact-config.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # 名前にハッシュが付いたファイル（_next/static）は中身が変わらないので、長くキャッシュする
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # 写真は1週間、HTML は毎回確認する
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
