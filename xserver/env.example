# Xserver で本番公開するための設定。
# このファイルを、プロジェクト直下に「.env.xserver」という名前でコピーして書き換えてください。
# （.env.xserver は git に入りません）

# --- サーバー（Xserver のサーバーパネル →「SSH設定」で確認できます） ---
XSERVER_SSH_HOST=sv00000.xserver.jp
XSERVER_SSH_USER=サーバーID
XSERVER_SSH_KEY=~/.ssh/xserver_hinata

# --- 公開するドメイン ---
XSERVER_DOMAIN=example.jp
SITE_URL=https://example.jp

# --- お問い合わせフォームのメール ---
# 受け取るアドレス（複数ならカンマ区切り）と、送信元のアドレス（このドメインのメールアドレス）
CONTACT_TO_EMAIL=info@example.jp
CONTACT_FROM_EMAIL=info@example.jp

# --- 検索エンジンに載せるか（本番は 1） ---
ALLOW_INDEX=1

# --- Google Search Console の所有権確認タグ（content の値。なければ空のまま） ---
GOOGLE_SITE_VERIFICATION=
